function LoginPage() {
  return (
    &lt;&gt;
      &lt;header&gt;
        &lt;nav className="navbar"&gt;
          &lt;img className="imglogo" src="./image/logo.png" alt="profile" /&gt;
          &lt;div className="nav-menu"&gt;
            &lt;a href="#"&gt;
              &lt;b&gt;Kategori&lt;/b&gt;
            &lt;/a&gt;
            &lt;a href="#"&gt;
              &lt;img src="./image/iconpp.img" alt="profile" /&gt;
            &lt;/a&gt;
          &lt;/div&gt;
        &lt;/nav&gt;
      &lt;/header&gt;
      &lt;main className="container"&gt;
        &lt;section className="hero"&gt;
          &lt;div className="hero-content"&gt;
            &lt;h1&gt;
              Revolusi Pembelajaran: Temukan Ilmu Baru melalui Platform Video
              Interaktif!
            &lt;/h1&gt;
            &lt;p&gt;
              Temukan ilmu baru yang menarik dan menyenangkan untuk dipelajari
              kapan saja dan di mana saja.
            &lt;/p&gt;
            &lt;button&gt;Temukan Video Course untuk Dipelajari!&lt;/button&gt;
          &lt;/div&gt;
        &lt;/section&gt;
        &lt;section className="video-section"&gt;
          &lt;div className="section-title"&gt;
            &lt;h2&gt; Koleksi Video Pembelajaran Unggulan&lt;/h2&gt;
            &lt;p&gt;Jelajahi Dunia Pengetahuan Melalui Pilihan Kami&lt;/p&gt;
          &lt;/div&gt;
          &lt;div className="category"&gt;
            &lt;a href="#" className="ative"&gt;
              Semua Kelas
            &lt;/a&gt;
            &lt;a href="#"&gt;Pemasaran&lt;/a&gt;
            &lt;a href="#"&gt; Pengembangan Diri&lt;/a&gt;
            &lt;a href="#"&gt; Bisnis&lt;/a&gt;
          &lt;/div&gt;
          &lt;div className="video-grid"&gt;
            &lt;article className="video-card"&gt;
              &lt;video src="image/video1.mp4" controls="" /&gt;
